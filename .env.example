# 是否启用真实 AgentScope Agent；0 表示使用本地演示执行器
AGENTSCOPE_LIVE=1
# 单个后台 Run 的安全上限（秒）；SSE 断开不会停止 Run
AGENT_RUN_TIMEOUT_SECONDS=1800

# 默认 OpenAI 兼容模型配置
OPENAI_API_KEY=your-api-key-here

# 可选：如果使用 DeepSeek 等兼容服务，在设置页添加模型时填写对应环境变量名
# DEEPSEEK_API_KEY=your-api-key-here

# 火山图片
HUOSHAN_IMG_API_KEY=your-api-key-here
# 万相视频
DASHSCOPE_API_KEY=your-api-key-here
# minimax音频
MINIMAX_API_KEY=your-api-key-here